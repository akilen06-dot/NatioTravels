# Copy this file to .env.local and fill in the values you have. The app runs
# fine with none of these set — it just uses local mock data, exactly like
# before. Each section only activates once its own keys are present. See
# SETUP.md for where to get each value.

# --- Phase 1: Database & auth (Supabase) ---------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Phase 3: Real location (OpenCage reverse geocoding) ------------------
VITE_GEOCODING_API_KEY=

# --- Phase 4: Real billing (Stripe) ---------------------------------------
# The publishable key is the only Stripe secret that belongs in frontend env.
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET / STRIPE_PRICE_* are Edge Function
# secrets — set those with `supabase secrets set`, never here.
VITE_STRIPE_PUBLISHABLE_KEY=
