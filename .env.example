# Copy this file to .env.local and fill in the values you have. The app runs
# fine with none of these set — it just uses local mock data, exactly like
# before. Each section only activates once its own keys are present. See
# SETUP.md for where to get each value.

# --- Phase 1: Database & auth (Supabase) ---------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Phase 3: Real location (OpenCage reverse geocoding) ------------------
VITE_GEOCODING_API_KEY=

# --- Phase 4: Real billing (Paddle) ----------------------------------------
# The client-side token is the only Paddle secret that belongs in frontend env.
# PADDLE_API_KEY / PADDLE_WEBHOOK_SECRET / PADDLE_PRICE_* / PADDLE_ENVIRONMENT
# are Edge Function secrets — set those with `supabase secrets set`, never here.
VITE_PADDLE_CLIENT_TOKEN=
# 'sandbox' (default) or 'production' — must match PADDLE_ENVIRONMENT below.
VITE_PADDLE_ENVIRONMENT=sandbox

# --- Phase 5: Error monitoring (Sentry) ------------------------------------
VITE_SENTRY_DSN=
