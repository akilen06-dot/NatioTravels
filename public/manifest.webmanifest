  "description": "Meet verified travelers from home, wherever your trip takes you.",
  "start_url": "/start",
  "display": "standalone",
  "background_color": "#FBF8F2",
  "theme_color": "#1D3FC4",
  "icons": [
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
